root = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
max_line_length = 120
insert_final_newline = true
# Compose functions are UpperCamelCase by convention (and Compose lint requires it).
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{xml,toml,properties,sh}]
indent_size = 4
indent_style = space
insert_final_newline = true
